{
  "name": "@neatlogs/neatroots-steer",
  "version": "0.2.9",
  "description": "Steering hook for neatroots: adds neatroots' guidance notes to your agent's next LLM call and gives it a check_my_work tool.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@opentelemetry/api": ">=1.4.0",
    "neatlogs": ">=1.1.0"
  },
  "peerDependenciesMeta": {
    "neatlogs": {
      "optional": true
    },
    "@opentelemetry/api": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --target node18",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "ai": "^7.0.131",
    "tsup": "^8.5.1",
    "typescript": "6.0.3",
    "vitest": "^5.0.3"
  }
}
