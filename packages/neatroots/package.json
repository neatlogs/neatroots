{
  "name": "@neatlogs/neatroots",
  "version": "0.2.9",
  "description": "Local, private checks for AI agents while they run. Collects traces from the public Neatlogs SDKs, checks them with local models, steers the agent and serves findings over MCP.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "neatroots": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "proto",
    "library",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup && node scripts/copy-ui.mjs",
    "dev": "tsx watch src/cli.ts start",
    "start": "node dist/cli.js start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.128.0",
    "@grpc/grpc-js": "1.14.6",
    "@hono/node-server": "^2.1.3",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "better-sqlite3": "^13.0.3",
    "commander": "^15.0.0",
    "hono": "^4.13.13",
    "protobufjs": "^8.8.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vitest": "^5.0.3"
  }
}
